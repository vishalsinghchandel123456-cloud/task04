val="2"/></w:numPr></w:pPr><w:r w:rsidRPr="00056792"><w:t>Vite is recommended.</w:t></w:r></w:p><w:p w14:paraId="693C648D" w14:textId="77777777" w:rsidR="00056792" w:rsidRPr="00056792" w:rsidRDefault="00056792" w:rsidP="00056792"><w:r w:rsidRPr="00056792"><w:t xml:space="preserve">The frontend is </w:t></w:r><w:r w:rsidRPr="00056792"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>not a major part of the evaluation</w:t></w:r><w:r w:rsidRPr="00056792"><w:t>. AI tools may be used freely for the frontend.</w:t></w:r></w:p><w:p w14:paraId="4CEA5834" w14:textId="77777777" w:rsidR="00056792" w:rsidRPr="00056792" w:rsidRDefault="00056792" w:rsidP="00056792"><w:r w:rsidRPr="00056792"><w:pict w14:anchorId="3163ADCD"><v:rect id="_x0000_i1104" style="width:0;height:1.5pt" o:hralign="center" o:hrstd="t" o:hr="t" fillcolor="#a0a0a0" stroked="f"/></w:pict></w:r></w:p><w:p w14:paraId="55469AB5" w14:textId="77777777" w:rsidR="00056792" w:rsidRPr="00056792" w:rsidRDefault="00056792" w:rsidP="00056792"><w:pPr><w:rPr><w:b/><w:bCs/></w:rPr></w:pPr><w:r w:rsidRPr="00056792"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>2. User Roles</w:t></w:r></w:p><w:p w14:paraId="10A9E71A" w14:textId="77777777" w:rsidR="00056792" w:rsidRPr="00056792" w:rsidRDefault="00056792" w:rsidP="00056792"><w:r w:rsidRPr="00056792"><w:t>The application must have three roles:</w:t></w:r></w:p><w:p w14:paraId="61137FA6" w14:textId="77777777" w:rsidR="00056792" w:rsidRPr="00056792" w:rsidRDefault="00056792" w:rsidP="00056792"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="3"/></w:numPr></w:pPr><w:r w:rsidRPr="00056792"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>User</w:t></w:r><w:r w:rsidRPr="00056792"><w:t xml:space="preserve"> – creates and manages their own tickets.</w:t></w:r></w:p><w:p w14:paraId="4414EDC7" w14:textId="77777777" w:rsidR="00056792" w:rsidRPr="00056792" w:rsidRDefault="00056792" w:rsidP="00056792"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="3"/></w:numPr></w:pPr><w:r w:rsidRPr="00056792"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>Support Agent</w:t></w:r><w:r w:rsidRPr="00056792"><w:t xml:space="preserve"> – handles assigned tickets and communicates with users.</w:t></w:r></w:p><w:p w14:paraId="71F2C966" w14:textId="77777777" w:rsidR="00056792" w:rsidRPr="00056792" w:rsidRDefault="00056792" w:rsidP="00056792"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="3"/></w:numPr></w:pPr><w:r w:rsidRPr="00056792"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>Admin</w:t></w:r><w:r w:rsidRPr="00056792"><w:t xml:space="preserve"> – manages tickets, users, and support agents.</w:t></w:r></w:p><w:p w14:paraId="0A2553A8" w14:textId="77777777" w:rsidR="00056792" w:rsidRPr="00056792" w:rsidRDefault="00056792" w:rsidP="00056792"><w:r w:rsidRPr="00056792"><w:t xml:space="preserve">You must implement </w:t></w:r><w:r w:rsidRPr="00056792"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>Role-Based Access Control (RBAC)</w:t></w:r><w:r w:rsidRPr="00056792"><w:t xml:space="preserve"> on the backend.</w:t></w:r></w:p><w:p w14:paraId="55070269" w14:textId="77777777" w:rsidR="00056792" w:rsidRPr="00056792" w:rsidRDefault="00056792" w:rsidP="00056792"><w:r w:rsidRPr="00056792"><w:pict w14:anchorId="580F4C71"><v:rect id="_x0000_i1105" style="width:0;height:1.5pt" o:hralign="center" o:hrstd="t" o:hr="t" fillcolor="#a0a0a0" stroked="f"/></w:pict></w:r></w:p><w:p w14:paraId="08F460B2" w14:textId="77777777" w:rsidR="00056792" w:rsidRPr="00056792" w:rsidRDefault="00056792" w:rsidP="00056792"><w:pPr><w:rPr><w:b/><w:bCs/></w:rPr></w:pPr><w:r w:rsidRPr="00056792"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>3. Authentication</w:t></w:r></w:p><w:p w14:paraId="222E4B62" w14:textId="77777777" w:rsidR="00056792" w:rsidRPr="00056792" w:rsidRDefault="00056792" w:rsidP="00056792"><w:r w:rsidRPr="00056792"><w:t>Implement:</w:t></w:r></w:p><w:p w14:paraId="650EA359" w14:textId="77777777" w:rsidR="00056792" w:rsidRPr="00056792" w:rsidRDefault="00056792" w:rsidP="00056792"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="4"/></w:numPr></w:pPr><w:r w:rsidRPr="00056792